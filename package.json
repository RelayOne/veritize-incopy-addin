{
  "name": "veritize-incopy-addin",
  "version": "0.1.0",
  "description": "Adobe InCopy UXP plugin for Veritize content verification.",
  "private": true,
  "type": "module",
  "license": "FSL-1.1-Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "package": "npm run build && node scripts/pack-ccx.mjs"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.55.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.3",
    "vite": "^5.4.20",
    "vitest": "^2.1.9"
  }
}
